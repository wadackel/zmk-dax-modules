config ZMK_DAX_SYSTEM_RPC
    bool "Reboot the keyboard, normally or into the bootloader, over custom Studio RPC"
    default n
    depends on ZMK_STUDIO
    help
      The dax_system subsystem. Anyone the Studio RPC answers can then reboot the
      keyboard into its UF2 bootloader, so it is off unless a keyboard asks for it.

config ZMK_TRACKBALL_SETTINGS
    bool "Runtime trackball sensor settings (CPI) in the dax settings layer"
    default n
    depends on PAW3222
    select ZMK_DAX_SETTINGS

config ZMK_DAX_HOLD_MACRO
    bool "Behavior that plays one dax macro on press and another on release"
    default y
    depends on DT_HAS_DAX_BEHAVIOR_HOLD_MACRO_ENABLED
    depends on ZMK_DAX_MACRO

config ZMK_DAX_SETTINGS
    bool
    select SETTINGS
    help
      The dax settings layer (include/dax/settings.h): values a feature edits at
      runtime, kept in RAM until saved. Selected by the features that use it.

if ZMK_DAX_SETTINGS

# Settings load on the main thread. zmk-feature-custom-settings, which these settings replace,
# saw a split central overflow the 1024-byte default main stack during that load and raised it
# this way. configdefault only raises the default; a board or user setting still wins.
configdefault MAIN_STACK_SIZE
    default 2048

config ZMK_DAX_SETTINGS_VALUE_MAX_SIZE
    int "Most bytes one setting slot holds"
    default 288 if ZMK_DAX_MACRO
    default 128
    help
      With ZMK_DAX_MACRO on, at least 1 + ZMK_DAX_MACRO_NAME_MAX +
      ZMK_DAX_MACRO_MAX_BYTES, the largest macro record; the build stops otherwise.

config ZMK_DAX_SETTINGS_TEST
    bool "Let a test read an owner's settings from flash again (tests only)"

config ZMK_DAX_SETTINGS_STUDIO_RPC
    bool "List and edit the typed dax settings over custom Studio RPC"
    default y
    depends on ZMK_STUDIO
    help
      The dax_settings subsystem (proto/dax/settings/settings.proto), through which
      a client edits the trackball and gesture settings.

endif

