config ZMK_TRACKBALL_SETTINGS
    bool "Runtime trackball sensor settings (CPI) through custom settings"
    default n
    depends on ZMK_CUSTOM_SETTINGS && PAW3222

config ZMK_DAX_MACRO_DEFAULTS
    bool "Discard puts a never-saved default runtime macro back to its devicetree body"
    default y
    depends on ZMK_RUNTIME_MACRO && ZMK_CUSTOM_SETTINGS_KEYSPACE

config ZMK_DAX_MACRO_DISCARD_TEST
    bool "Edit and discard a default runtime macro shortly after boot (tests only)"
    default n
    depends on ZMK_RUNTIME_MACRO

config ZMK_DAX_MACRO_DISCARD_TEST_NAME
    string "Name of the default macro the test edits"
    default "esc_lang2"
    depends on ZMK_DAX_MACRO_DISCARD_TEST

config ZMK_DAX_GESTURE
    bool "Stroke gestures for a pointing device"
    default y
    depends on DT_HAS_DAX_INPUT_PROCESSOR_GESTURE_ENABLED
    depends on ZMK_POINTING

if ZMK_DAX_GESTURE

config ZMK_DAX_GESTURE_MAX_GESTURES
    int "Gesture slots across all profiles"
    default 16
    range 1 64
    help
      Room for the devicetree gestures plus the ones added at runtime.

config ZMK_DAX_GESTURE_RUNTIME
    bool "Edit gesture tuning, profiles and gestures through custom settings"
    default y
    depends on ZMK_CUSTOM_SETTINGS && ZMK_BEHAVIOR_LOCAL_IDS

config ZMK_DAX_GESTURE_RPC
    bool "Report recognition and capture patterns over custom Studio RPC"
    default y
    depends on ZMK_STUDIO_RPC

endif
