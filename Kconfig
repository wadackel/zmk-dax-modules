config ZMK_OS_LAYER
    bool "OS Layer switching based on BLE profile"
    default n

if ZMK_OS_LAYER

config ZMK_OS_LAYER_PROFILE_0
    int "Layer for BLE profile 0 (-1 = none)"
    default -1
    range -1 31

config ZMK_OS_LAYER_PROFILE_1
    int "Layer for BLE profile 1 (-1 = none)"
    default -1
    range -1 31

config ZMK_OS_LAYER_PROFILE_2
    int "Layer for BLE profile 2 (-1 = none)"
    default -1
    range -1 31

config ZMK_OS_LAYER_PROFILE_3
    int "Layer for BLE profile 3 (-1 = none)"
    default -1
    range -1 31

config ZMK_OS_LAYER_PROFILE_4
    int "Layer for BLE profile 4 (-1 = none)"
    default -1
    range -1 31

endif

config ZMK_TRACKBALL_SETTINGS
    bool "Runtime trackball sensor settings (CPI) through custom settings"
    default n
    depends on ZMK_CUSTOM_SETTINGS && PAW3222

config ZMK_DAX_GESTURE
    bool "Stroke gestures for a pointing device"
    default y
    depends on DT_HAS_DAX_INPUT_PROCESSOR_GESTURE_ENABLED
    depends on ZMK_POINTING

if ZMK_DAX_GESTURE

config ZMK_DAX_GESTURE_MAX_GESTURES
    int "Gesture slots across all profiles"
    default 16
    range 1 64
    help
      Room for the devicetree gestures plus the ones added at runtime.

config ZMK_DAX_GESTURE_RUNTIME
    bool "Edit gesture tuning, profiles and gestures through custom settings"
    default y
    depends on ZMK_CUSTOM_SETTINGS && ZMK_BEHAVIOR_LOCAL_IDS

endif
