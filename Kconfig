    int "Combo slots"
    default 8
    range 1 16

config ZMK_DAX_COMBO_MAX_KEYS_PER_COMBO
    int "Key positions per combo"
    default 16
    range 1 16

config ZMK_DAX_COMBO_DEFAULT_TIMEOUT_MS
    int "Default combo timeout"
    default 50
    range 1 65535

config ZMK_DAX_COMBO_DEFAULT_REQUIRE_PRIOR_IDLE_MS
    int "Default combo require-prior-idle time"
    default 0
    range 0 65535
    help
      A combo is skipped if a non-modifier key was tapped within this many
      milliseconds before its first key. 0 disables the check.

