# Nanopb options file for combo.proto, adapted from cormoran/zmk-feature-runtime-combo
# (proto/cormoran/runtime_combo/runtime_combo.options at d9490e7).

dax.combo.Combo.name                         max_size:64
dax.combo.Combo.key_positions                max_count:16
dax.combo.SetComboRequest.key_positions      max_count:16
dax.combo.SetComboNameRequest.name           max_size:64
dax.combo.ListCombosResponse.combos          max_count:16
dax.combo.ErrorResponse.message              max_size:64
dax.combo.StatusResponse.message             max_size:64
