#include "../common.dtsi"

// CONFIG_ZMK_DAX_POINTER_TEST_EDIT_DISCARD (src/test/pointer_test.c) writes scale_mul 3 and a
// rotation of 90 degrees right after boot and discards at 1450 ms: right 2 (1000-1300 ms) is
// sent as down 6, and right 2 again (1600-1900 ms) as right 2.
/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <&none &none &none &none>;
        };
    };

    edited: edited {
        compatible = "dax,input-processor-pointer";
        #input-processor-cells = <0>;
        display-name = "Edited";
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
    };

    mock_trackball: mock_trackball {
        compatible = "zmk,input-mock";
        event-startup-delay = <1000>;
        event-period = <300>;
        events
            = <INPUT_EV_REL INPUT_REL_X 2 0>
            , <INPUT_EV_REL INPUT_REL_Y 0 1>
            , <INPUT_EV_REL INPUT_REL_X 2 0>
            , <INPUT_EV_REL INPUT_REL_Y 0 1>
            ;
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&mock_trackball>;
        input-processors = <&edited>;
    };
};

&kscan {
    events = <ZMK_MOCK_PRESS(0,0,1250) ZMK_MOCK_RELEASE(0,0,10)>;
};
