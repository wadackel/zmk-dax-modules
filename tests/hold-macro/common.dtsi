#include <behaviors.dtsi>
#include <behaviors/hold_macro.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

// The press macro holds LGUI and layer 1 and taps TAB; the release macro lets both go. With no
// other default macros they take slots 0 and 1.
/ {
    hold_press {
        compatible = "cormoran,runtime-macro-default";
        bindings = <&macro_press &kp LGUI &mo 1>, <&macro_tap &kp TAB>;
    };

    hold_release {
        compatible = "cormoran,runtime-macro-default";
        bindings = <&macro_release &mo 1 &kp LGUI>;
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <&dax_hold_macro 0 1 &kp A &kp B &none>;
        };
        hold_layer {
            bindings = <&trans &kp TAB &kp LS(TAB) &none>;
        };
    };
};
